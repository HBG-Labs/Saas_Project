{
  "schema": "pattern-definition",
  "schema_version": "0.2.0",
  "id": "statement.interrupt",
  "version": "0.2.0",
  "description": "Affirmation courte lue ligne à ligne ; un mot pivot peut s'accentuer au moment où la voix le prononce puis se stabiliser ; un trait ponctue la phrase ; l'ensemble libère l'écran avant la suite.",
  "family": "statement",
  "accepts": {
    "roles": ["setup", "tension", "interruption", "turn", "resolution"],
    "max_lines": 3
  },
  "variation_axes": {
    "layout_variant": { "values": ["stack_start", "stack_center"], "default": "stack_start" },
    "motion_variant": { "values": ["rise_reveal", "soft_reveal"], "default": "rise_reveal" },
    "energy": { "values": ["low", "medium", "high"], "default": "medium" },
    "hierarchy_variant": { "values": ["accent_last", "uniform"], "default": "accent_last" }
  },
  "layouts": {
    "stack_start": {
      "slots": {
        "statement.primary": { "kind": "region", "x": [0, 1], "y": [0.3, 0.62], "align_x": "start", "align_y": "end" },
        "statement.rule": { "kind": "follow", "of": "statement.primary", "gap": "md", "align_x": "start" }
      }
    },
    "stack_center": {
      "slots": {
        "statement.primary": { "kind": "region", "x": [0, 1], "y": [0.3, 0.62], "align_x": "center", "align_y": "center" },
        "statement.rule": { "kind": "follow", "of": "statement.primary", "gap": "md", "align_x": "center" }
      }
    }
  },
  "motions": {
    "rise_reveal": {
      "reveal": { "behavior": "REVEAL_TEXT", "variant": "rise" },
      "accent": { "behavior": "ACCENT_WORD", "variant": "color_scale", "offset_beats": -0.25 },
      "settle": { "behavior": "SETTLE" },
      "punctuate": { "behavior": "DRAW_PATH" },
      "exit": { "behavior": "EXIT_CLEAR", "variant": "lift" }
    },
    "soft_reveal": {
      "reveal": { "behavior": "REVEAL_TEXT", "variant": "fade" },
      "accent": { "behavior": "ACCENT_WORD", "variant": "color_only", "offset_beats": 0 },
      "settle": { "behavior": "SETTLE" },
      "punctuate": { "behavior": "DRAW_PATH" },
      "exit": { "behavior": "EXIT_CLEAR", "variant": "fade" }
    }
  },
  "hierarchies": {
    "accent_last": { "accent": true },
    "uniform": { "accent": false }
  },
  "elements": {
    "statement": { "slot": "statement.primary", "type": "type.display.m", "color": "color.text.primary", "accent_color": "color.accent" },
    "rule": { "slot": "statement.rule", "motif": "motif.rule", "stroke": "color.accent", "weight": "stroke.emphasis" }
  },
  "background": "color.surface.primary",
  "subtitles": "off"
}
