# =============================================================================
# REZO360 — variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs :
#     Copy-Item .env.example .env.local
#
# `.env.local` est ignoré par Git (voir .gitignore). Ce fichier-ci est le SEUL
# fichier d'environnement versionné, et il ne doit JAMAIS contenir de valeur
# réelle.
# =============================================================================

# URL du projet Supabase — Dashboard > Project Settings > Data API
VITE_SUPABASE_URL=https://votre-project-ref.supabase.co

# Clé PUBLIQUE (« Publishable key » sb_publishable_... ou clé « anon » legacy).
# Elle est conçue pour être exposée au navigateur : toute la protection repose
# sur les politiques Row Level Security définies dans supabase/migrations/.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# development | staging | production
VITE_APP_ENV=development

# Identifiant facultatif du déploiement, utilisé dans le journal des erreurs.
# En production, utilisez de préférence le SHA du commit déployé.
VITE_APP_VERSION=local

# -----------------------------------------------------------------------------
# ⚠️  NE JAMAIS AJOUTER ICI :
#
#     SUPABASE_SERVICE_ROLE_KEY
#
# La clé `service_role` CONTOURNE la Row Level Security. Elle est réservée à un
# environnement serveur (Edge Function, backend). Vite n'expose au bundle que
# les variables préfixées `VITE_`, mais une clé serveur n'a de toute façon
# aucune raison de figurer dans ce dépôt.
# -----------------------------------------------------------------------------

# Facultatif — adresse publique de l'application. Sans elle, les liens
# d'invitation reprennent l'origine de la page, ce qui donne un lien localhost
# en développement. Renseignez la même valeur que le secret APP_URL.
VITE_PUBLIC_APP_URL=
